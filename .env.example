# Copy to .env.local and adjust for your environment.

# Backend BFF base URL — read server-side by next.config.ts rewrites().
# The browser talks same-origin to the Next dev server; Next proxies these to the backend.
BACKEND_BASE_URL=http://localhost:3000

# Public origin of this FE app (used by the better-auth client for its absolute baseURL).
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3001
